# LINE Developers > チャネル基本設定 > チャネルシークレット
LINE_CHANNEL_SECRET=
# LINE Developers > Messaging API設定 > チャネルアクセストークン（長期）
LINE_CHANNEL_ACCESS_TOKEN=

# GCS バケット名（デフォルト: probox-linetask-prod-intake）
GCS_BUCKET=probox-linetask-prod-intake
# Firestore プロジェクト（デフォルト: probox-linetask-prod）
FIRESTORE_PROJECT=probox-linetask-prod

# true にすると GCS/Firestore をスキップし server/tmp/ に保存（ローカルデバッグ用）
LOCAL_FALLBACK=true
