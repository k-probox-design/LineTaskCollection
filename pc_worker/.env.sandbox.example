# ============================================================================
# Cowork サンドボックス本番用 .env テンプレート（既知値は記入済み）
#
# 使い方: OneDrive の pc_cli/ 配下にこれを .env としてコピーし、
#   ① NOTION_API_KEY を記入
#   ② secrets/linetask-puller.json に GCP サービスアカウント鍵を配置（GOOGLE_APPLICATION_CREDENTIALS は記入済み）
# の 2 点だけ行えば動く。パスはすべて Windows 絶対形式（pc_cli が実行時に動的マウントへ解決）。
# ============================================================================

# --- ① けいすけが記入 -------------------------------------------------------
NOTION_API_KEY=
# private repo の Contents:Read 権限 fine-grained PAT。サンドボックスが git clone でコードを取得する。
GITHUB_PAT=

# --- 記入済み（変更不要） ---------------------------------------------------
NOTION_DATABASE_ID_DESIGN_TASK=1eb17f63-e23f-8049-b326-d299bae15518
# 任意。空でも databases.retrieve で自動解決する。スモークで確認した実 data_source_id を
# 固定しておくと API 呼び出しを 1 回省ける（DB が単一データソースのうちは安全）。
NOTION_DATA_SOURCE_ID=1eb17f63-e23f-8070-aeb2-000b0f9cd108
# 既定優先度（ボット起因の目印。実 DB に option「Claude追記」あり）
NOTION_DEFAULT_PRIORITY=Claude追記
# 担当(person) 既定 = けいすけ（中村圭佑）。人別ビューに乗せるため
NOTION_DEFAULT_ASSIGNEE_USER_ID=1b2d872b-594c-81ad-a589-00021d50994d
GCS_BUCKET=probox-linetask-prod-intake
FIRESTORE_PROJECT=probox-linetask-prod

# ② この絶対パスに SA 鍵 JSON を置く（secrets/ は同期・コミット対象外）
GOOGLE_APPLICATION_CREDENTIALS=C:\Users\knaka\OneDrive - 株式会社ビギン\@@設計\51.LINE投稿ボット\secrets\linetask-puller.json

# マウント写像（@@@ と 51.LINE投稿ボット の 2 つを Cowork にマウントしている前提）
MOUNT_MAP=C:\Users\knaka\OneDrive - 株式会社ビギン\@@@;C:\Users\knaka\OneDrive - 株式会社ビギン\@@設計\51.LINE投稿ボット

# 案件フォルダ探索の起点（@@@ 配下を再帰スキャン）
SHAREPOINT_ROOT=C:\Users\knaka\OneDrive - 株式会社ビギン\@@@

# download 保存先 / ログ複製先（51.LINE投稿ボット 配下）
TMP_DOWNLOAD_DIR=C:\Users\knaka\OneDrive - 株式会社ビギン\@@設計\51.LINE投稿ボット\pc_worker_tmp
LOG_OUTPUT_DIR=C:\Users\knaka\OneDrive - 株式会社ビギン\@@設計\51.LINE投稿ボット\pc_worker_logs
