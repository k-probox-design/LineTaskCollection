# Notion（設計タスク管理 DB への記録）
NOTION_API_KEY=
NOTION_DATABASE_ID_DESIGN_TASK=

# GCP（Application Default Credentials 経由を推奨、設定方法は docs/operations.md §WSL2 で ADC を設定する）
GCS_BUCKET=probox-linetask-prod-intake
FIRESTORE_PROJECT=probox-linetask-prod

# SharePoint（案件フォルダの親。WSL 実行なので /mnt/c 経由で OneDrive 同期フォルダを指す）
# 例: /mnt/c/Users/knaka/OneDrive - 株式会社ビギン/Documents/案件
SHAREPOINT_ROOT=

# download サブコマンドの既定保存先。未設定なら system tmp。Cowork が Read tool で読める場所を推奨。
# 例: /mnt/c/Users/knaka/OneDrive - 株式会社ビギン/@@設計/51.LINE投稿ボット/pc_worker_tmp
TMP_DOWNLOAD_DIR=

# 実行ログの OneDrive 複製先（Cowork 監査用）。未設定ならコンソール(stderr)出力のみ。
# 出力先は $LOG_OUTPUT_DIR/YYYY-MM-DD/<run_id>.jsonl
# 例: /mnt/c/Users/knaka/OneDrive - 株式会社ビギン/@@設計/51.LINE投稿ボット/pc_worker_logs
LOG_OUTPUT_DIR=
