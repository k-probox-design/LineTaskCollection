# ============================================================================
# pc_cli 設定テンプレート
#
# 実行拠点は 2 つ:
#   (A) WSL ローカル開発  … パスは /mnt/c/... の unix 形式、GCP は ADC でよい
#   (B) Cowork サンドボックス本番 … パスは Windows 絶対形式、GCP は SA 鍵ファイル
#
# SHAREPOINT_ROOT / TMP_DOWNLOAD_DIR / LOG_OUTPUT_DIR / GOOGLE_APPLICATION_CREDENTIALS は
# 「Windows 絶対パス」でも「unix パス」でも書ける。Windows 形式で書くと pc_cli が
# 実行時に実マウント先（WSL は /mnt/c、サンドボックスは /sessions/<動的>/mnt）へ解決する。
# 詳細は docs/cowork-skill-reference.md §マウント解決。
# ============================================================================

# --- Notion（設計タスク管理 DB への記録） -----------------------------------
NOTION_API_KEY=
NOTION_DATABASE_ID_DESIGN_TASK=
# 任意。Notion-Version 2025-09-03 では DB ではなくデータソース単位で読み書きする。
# 未設定なら pc_cli が databases.retrieve で data_sources[0] を自動解決する（1 回 API 呼び出し）。
# 固定して API 呼び出しを省きたい場合のみ設定。
NOTION_DATA_SOURCE_ID=
# write-task の既定優先度（ボット起因の目印）。未設定なら "Claude追記"。
NOTION_DEFAULT_PRIORITY=
# write-task で 担当(person) に既定セットする Notion user_id。未設定なら担当を触らない（人別ビューに乗らない）。
NOTION_DEFAULT_ASSIGNEE_USER_ID=

# --- GitHub（サンドボックスが git clone でコードを取得するための PAT） ---------
# Cowork サンドボックスは OneDrive プレースホルダを完全に読めないため、コードは GitHub から
# git clone する（scripts/sandbox-bootstrap.sh）。private repo の Contents:Read 権限の
# fine-grained PAT を設定する。WSL ローカル開発では不要（空でよい）。
GITHUB_PAT=

# --- GCP ---------------------------------------------------------------------
GCS_BUCKET=probox-linetask-prod-intake
FIRESTORE_PROJECT=probox-linetask-prod
# サービスアカウント鍵ファイル。設定すると鍵認証、未設定なら ADC にフォールバック。
# Windows 形式で書けばサンドボックスの動的マウントを解決する。リポジトリ／OneDrive 同期対象に
# 鍵 JSON 本体は置かない（secrets/ は .gitignore 済み）。
# 例(サンドボックス): C:\Users\knaka\OneDrive - 株式会社ビギン\@@設計\51.LINE投稿ボット\secrets\linetask-puller.json
# 例(WSL ADC):        （空のまま。gcloud auth application-default login で解決）
GOOGLE_APPLICATION_CREDENTIALS=

# --- マウント写像（サンドボックス動的パス対応の要） --------------------------
# Cowork にマウントしている Windows フォルダの「静的な絶対パス」を ; 区切りで列挙する。
# pc_cli が実行時に実マウント先 unix パスを検出し、出力する destination_windows 等を
# 正しい C:\... 形に戻す（winpath 一般化）。WSL 実行では空でも /mnt 規則で動く。
# 例: C:\Users\knaka\OneDrive - 株式会社ビギン\@@@;C:\Users\knaka\OneDrive - 株式会社ビギン\@@設計\51.LINE投稿ボット
MOUNT_MAP=

# --- パス（Windows 形式 or unix 形式どちらでも可） ---------------------------
# 案件フォルダ探索の起点（list-case-folders が配下を再帰スキャン）。通常は @@@ を指す。
# 例(サンドボックス): C:\Users\knaka\OneDrive - 株式会社ビギン\@@@
# 例(WSL):            /mnt/c/Users/knaka/OneDrive - 株式会社ビギン/@@@
SHAREPOINT_ROOT=

# download の既定保存先。未設定なら system tmp。Cowork が Read で読める場所を推奨。
# 例(サンドボックス): C:\Users\knaka\OneDrive - 株式会社ビギン\@@設計\51.LINE投稿ボット\pc_worker_tmp
TMP_DOWNLOAD_DIR=

# 実行ログの複製先（Cowork 監査用）。未設定ならコンソール(stderr)のみ。
# 出力先は $LOG_OUTPUT_DIR/YYYY-MM-DD/<run_id>.jsonl
# 例(サンドボックス): C:\Users\knaka\OneDrive - 株式会社ビギン\@@設計\51.LINE投稿ボット\pc_worker_logs
LOG_OUTPUT_DIR=
