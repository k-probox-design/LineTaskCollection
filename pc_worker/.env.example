# Anthropic（仕分け判断）
ANTHROPIC_API_KEY=

# Notion（設計タスク管理 DB への記録）
NOTION_API_KEY=
NOTION_DATABASE_ID_DESIGN_TASK=

# GCP（Application Default Credentials 経由を推奨、設定方法は docs/operations.md §WSL2 で ADC を設定する）
GCS_BUCKET=probox-linetask-prod-intake
FIRESTORE_PROJECT=probox-linetask-prod

# SharePoint（案件フォルダの親。A 方針=WSL 実行なので /mnt/c 経由で OneDrive 同期フォルダを指す）
# 例: /mnt/c/Users/knaka/OneDrive - 株式会社ビギン/Documents/案件
SHAREPOINT_ROOT=

# 実行ログの OneDrive 複製先（Cowork 監査用）。未設定ならコンソール出力のみ。
# 出力先は $LOG_OUTPUT_DIR/YYYY-MM-DD/<run_id>.jsonl
# 例: /mnt/c/Users/knaka/OneDrive - 株式会社ビギン/@@設計/51.LINE投稿ボット/pc_worker_logs
LOG_OUTPUT_DIR=

# 仕分けしきい値（CLAUDE.md §仕分けロジック、初期 0.8）
CLASSIFY_CONFIDENCE_THRESHOLD=0.8

# 議事ログの集約単位（同 groupId 内で前後 N 時間の text/file を 1 議事ログにまとめる）
LOG_AGGREGATION_HOURS=24

# 仕分け候補に含める既存タスクの登録日数（直近 N 日以内のタスク名のみ候補化、context overflow 防止）
CANDIDATE_LOOKBACK_DAYS=90

# Claude モデル
CLASSIFY_MODEL=claude-sonnet-4-6
